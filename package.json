{
  "name": "@fgfg163/dsh-agentmemory-plugin",
  "version": "0.13.1",
  "description": "DeepSeek Harness native integration for AgentMemory: captures session events, injects per-session memory, and recalls relevant memories per turn. Community fork of the DSH integration shipped inside @agentmemory/agentmemory, with two local fixes applied and the former dsh-agentmemory-recall plugin merged in. Versioned independently of upstream.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README_CN.md",
    "LICENSE",
    "NOTICE",
    "test"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@fgfg163/dsh-prompt-slot": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@fgfg163/dsh-prompt-slot": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "agentmemory",
    "memory",
    "hooks",
    "capture",
    "recall"
  ],
  "license": "Apache-2.0",
  "author": "fgfg163",
  "homepage": "https://github.com/fgfg163/dsh-agentmemory-plugin#readme",
  "bugs": {
    "url": "https://github.com/fgfg163/dsh-agentmemory-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fgfg163/dsh-agentmemory-plugin.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  }
}
